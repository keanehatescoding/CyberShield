{
  "name": "cybershield-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Server-side answer validation for CyberShield quizzes.",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "migrate:answerKeys": "npm run build && node lib/scripts/migrateAnswerKeys.js"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
